\newcommand{\OpalonOath}{%
  \OpalonOathSeed1\par\medskip
  \OpalonOathSeed2\par\medskip
  \OpalonOathSeed3\par\medskip
  \OpalonOathSeed4\par\medskip
  \OpalonOathSeed5\par\medskip
  \OpalonOathSeed6\par\medskip
  \OpalonOathSeed7%
}
