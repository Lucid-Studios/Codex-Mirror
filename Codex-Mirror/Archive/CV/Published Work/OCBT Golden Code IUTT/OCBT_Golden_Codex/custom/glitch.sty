\section*{Appendix F — Glitch \& Fey Voice Usage}
\addcontentsline{toc}{section}{Appendix F — Glitch \& Fey Voice Usage}

\subsection*{F.1 Engine \& Loading}
\begin{itemize}[leftmargin=2em]
  \item \textbf{Requires}: LuaLaTeX for visual effects. With other engines, \texttt{glitch.sty} degrades gracefully and prints plain text (emits a package warning).
  \item \textbf{Load}: \verb|\usepackage{custom/glitch}| (already included). No extra setup is required.
\end{itemize}

\subsection*{F.2 Core Commands}
\begin{description}[style=nextline,leftmargin=2.5em]
  \item[\verb|\glitch{<text>}{<modes>}|] Apply glitch to inline text.
  \item[\verb|\glitchmath{<text>}{<modes>}|] Same API, for math-ish contexts; renders like \verb|\glitch|.
\end{description}

\noindent\textbf{Modes}
\begin{center}
\begin{tabular}{@{}ll@{}}
\toprule
Mode & Effect \\
\midrule
\verb|C|  & Color shuffle (per-glyph random color) \\
\verb|F|  & Font shuffle (cycles \emph{glitchmain/altA/altB/altC/altD}) \\
\verb|CF| & Both color and font shuffle (default in fairy helpers) \\
\bottomrule
\end{tabular}
\end{center}

\subsection*{F.3 Fey Helpers (Between-Paragraph Whispers)}
These are convenience macros that open the “fairy gate” (allowing font shuffle) and apply vertical breathing space.
\begin{description}[style=nextline,leftmargin=2.5em]
  \item[\verb|\fairy[<modes>]{<text>}|] One-line whisper. Default \verb|[CF]|.
  \item[\verb|fairyblock[<modes>] ... \end{fairyblock}|] Multi-line; use \verb|\fairyline{...}| inside.
  \item[\verb|\FeyWhisper{<text>}|] Official Fey channel: identical to \verb|\fairy[CF]{...}|.
\end{description}

\noindent\textbf{Examples}
\begin{verbatim}
% Inline:
We invoke the gate: \glitch{Glyph align}{CF} and proceed.

% One-line whisper:
\FeyWhisper{Five reflections; one witness.}

% Multi-line block:
\begin{fairyblock}[CF]
  \fairyline{The bloom returns as echo.}
  \fairyline{The echo returns as vow.}
\end{fairyblock}
\end{verbatim}

\subsection*{F.4 Tuning the Look (Document-Level Knobs)}
The package exposes simple, engine-agnostic knobs. You can \verb|\renewcommand| them in your preamble.
\begin{center}
\begin{tabular}{@{}lll@{}}
\toprule
Command & Default & Meaning \\
\midrule
\verb|\glitchKernRange|   & \verb|-0.06,0.12| & per-glyph extra kern in em (min,max) \\
\verb|\glitchRaiseRange|  & \verb|-0.10,0.20| & per-glyph raise in ex/em-ish units (min,max) \\
\verb|\glitchSpaceWidth|  & \verb|0.333|     & space width used between words (em) \\
\verb|\glitchseed{<n>}|   & —               & set a deterministic seed for reproducible output \\
\bottomrule
\end{tabular}
\end{center}

\noindent\textbf{Examples}
\begin{verbatim}
% Make the effect subtler:
\renewcommand*\glitchKernRange{-0.03,0.06}
\renewcommand*\glitchRaiseRange{-0.05,0.10}
\renewcommand*\glitchSpaceWidth{0.28}

% Reproducible runs:
\glitchseed{424242}
\end{verbatim}

\subsection*{F.5 Best Practices \& Safety}
\begin{itemize}[leftmargin=2em]
  \item \textbf{Moving arguments}: avoid glitch macros inside section titles, captions, or bookmarks.
        If needed, protect with \verb|\texorpdfstring|:
\begin{verbatim}
\section[\texorpdfstring{Glyph Align}{Glyph Align}]{Glyph Align}
\end{verbatim}
  \item \textbf{Line breaks}: long whispers can cause overfull boxes. Add \verb|\\| breaks or use a
        \verb|\parbox|minipage when needed.
  \item \textbf{Weight/shape}: the renderer uses \verb|\normalfont\upshape\mdseries| per glyph for stability.
        Treat glitch as its own emphasis; don’t rely on \verb|\textbf| or \verb|\emph| inside it.
  \item \textbf{Engine fallback}: with non-Lua engines the macros print plain text and still respect the
        top/bottom spacing of \verb|\fairy|/\verb|\FeyWhisper|.
\end{itemize}

\subsection*{F.6 Quick Reference}
\begin{verbatim}
% Inline glitch:
\glitch{<text>}{C|F|CF}

% Math variant (same visual behavior):
\glitchmath{<E=mc^2>}{CF}

% One-line Fey:
\FeyWhisper{<text>}

% Block Fey:
\begin{fairyblock}[CF]
  \fairyline{<line 1>}
  \fairyline{<line 2>}
\end{fairyblock}

% Tuning:
\renewcommand*\glitchKernRange{<min,max>}
\renewcommand*\glitchRaiseRange{<min,max>}
\renewcommand*\glitchSpaceWidth{<em>}
\glitchseed{<integer>}
\end{verbatim}
