%% Lua code to draw watermark
\begin{luacode*}
function draw_oria_watermark()
  local img_path = "OCBTsigil.png"
  local pdf = require("epdf")
  local img = pdf.load(img_path)
  local w, h = img:width(), img:height()
  local scale = 0.45
  local x = 0.5 * (tex.pagewidth - scale * w)
  local y = 0.5 * (tex.pageheight - scale * h)
  img:place(x, y, scale)
end
\end{luacode*}

